{
  "name": "inter_oge",
  "version": "1.0.0",
  "description": "Веб-приложение для проведения виртуальных лабораторных работ по физике с оборудованием **Labosfera** (www.labosfera.ru). Идеально подходит для интерактивных панелей и сенсорных экранов.",
  "main": "app.js",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --forceExit",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug",
    "test:all": "npm run test && npm run test:e2e",
    "serve": "npx http-server . -p 8080 -c-1"
  },
  "keywords": [
    "physics",
    "education",
    "OGE",
    "laboratory",
    "simulation"
  ],
  "author": "Labosfera Team",
  "license": "ISC",
  "dependencies": {
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "http-server": "^14.1.1",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "moduleFileExtensions": [
      "js",
      "mjs"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "experiments/shared/**/*.js",
      "experiments/kit2/modules/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
