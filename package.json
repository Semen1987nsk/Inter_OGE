{
  "name": "inter-oge-lab",
  "version": "1.0.0",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prebuild": "node copy-files.js",
    "build": "electron-packager . \"Inter OGE Lab\" --platform=win32 --arch=x64 --out=dist --overwrite",
    "build:setup": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.labosfera.interoge",
    "productName": "Inter OGE Lab",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "**/*",
      "!dist/*",
      "!build-resources/*",
      "!src/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2"
  }
}
