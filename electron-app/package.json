{
  "name": "inter-oge-lab",
  "version": "1.0.0",
  "main": "main.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Semen1987nsk/Inter_OGE.git"
  },
  "scripts": {
    "start": "electron .",
    "prebuild": "node copy-files.js",
    "build": "electron-packager . \"Inter OGE Lab\" --platform=win32 --arch=x64 --out=dist --overwrite",
    "build:linux": "electron-builder --linux AppImage",
    "build:setup": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.labosfera.interoge",
    "productName": "Inter OGE Lab",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "files": [
      "**/*",
      "!dist/*",
      "!build-resources/*",
      "!src/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2"
  }
}
