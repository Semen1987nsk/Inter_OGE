#!/bin/sh
# Pre-push. GitHub Actions в репозитории нет (решение владельца 2026-10-22):
# все проверки идут при пуше в main/master, этот хук и есть гейт. Включается
# тем же core.hooksPath, что и pre-commit.
#
# 1. Исход гейта получает машинное следствие — последний REJECT без
#    записанного «решение_владельца» не отгружается вместе с новой работой.
#    Сам вердикт, история и правки спеки в цикле раундов проходят всегда;
#    ESCALATE не блокирует. Логика и признанный предел радиуса — gate_guard.py,
#    блок push-check. Нет python — шаг пропускается: падение проверялки не
#    запирает работу.
# 2. Пуш в main/master: секреты по отправляемым коммитам (pre-commit видит
#    только итог индекса, а не секрет, добавленный и удалённый внутри ветки),
#    затем тесты. Тесты идут по рабочему дереву — пушить из чистого.

refs=$(cat)
ZERO=0000000000000000000000000000000000000000

if command -v python >/dev/null 2>&1; then
    printf '%s\n' "$refs" | python "$HOME/.claude/hooks/gate_guard.py" --push-check || exit 1
fi

to_main=0
while read -r lref lsha rref rsha; do
    case "$rref" in refs/heads/main|refs/heads/master) ;; *) continue ;; esac
    [ "$lsha" = "$ZERO" ] && continue
    to_main=1
    # Удалённого main ещё нет — вся история: исключение по --remotes доверяло
    # бы любой локально настроенной удалённой ветке.
    if [ "$rsha" = "$ZERO" ]; then log="$lsha"; else log="$rsha..$lsha"; fi
    echo "[pre-push → main] gitleaks ($log)"
    gitleaks git --redact --log-opts "$log" . || exit 1
done <<EOF
$refs
EOF
[ "$to_main" = 1 ] || exit 0

# Снятый CI ставил зависимости через npm ci и падал на package-lock.json,
# разошедшемся с package.json. Здесь npm ci переписал бы отслеживаемый
# node_modules, а сверка дерева lock-файла с диапазонами — нет.
echo "[pre-push → main] package-lock.json совпадает с package.json"
npm ls --package-lock-only --all >/dev/null || exit 1

# В индексе лежит старая копия node_modules с одним playwright, jest в ней нет;
# npm ci перепишет и её — после установки `git checkout -- node_modules`.
if [ ! -f node_modules/jest/bin/jest.js ]; then
    echo "[pre-push → main] jest не установлен: npm ci, затем git checkout -- node_modules" >&2
    exit 1
fi
echo "[pre-push → main] тесты"
npm test || exit 1

# Браузер Playwright ставится отдельно от npm ci; без него e2e упал бы на
# запуске, а не на проверке — отказ должен сказать, что поставить.
if ! node -e "require('playwright').chromium.launch().then((b) => b.close())" >/dev/null 2>&1; then
    echo "[pre-push → main] нет браузера chromium для Playwright: npx playwright install chromium" >&2
    exit 1
fi
echo "[pre-push → main] e2e chromium"
npx playwright test --project=chromium || exit 1

echo "[pre-push → main] OK"
