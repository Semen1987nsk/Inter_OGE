#!/bin/sh
# Pre-push: исход гейта получает машинное следствие — последний REJECT без
# записанного «решение_владельца» не отгружается вместе с новой работой.
# Сам вердикт, история и правки спеки в цикле раундов проходят всегда;
# ESCALATE не блокирует (его смысл — «стоп и таблица владельцу», материалы
# обязаны уехать). Логика и признанный предел радиуса — gate_guard.py,
# блок push-check. Включается тем же core.hooksPath, что и pre-commit.
# Нет python — молча пустить: падение проверялки не запирает работу.
command -v python >/dev/null 2>&1 || exit 0
exec python "$HOME/.claude/hooks/gate_guard.py" --push-check
